{
	"name": "mac-harness",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"assets": "node scripts/generate-assets.js",
		"check:contrast": "node scripts/check-hero-contrast.cjs",
		"check:masonry": "node scripts/check-masonry.mjs",
		"build": "eleventy && npm run css && npm run js",
		"dev": "run-p serve css:watch \"js -- --watch\"",
		"serve": "eleventy --serve",
		"css": "tailwindcss -i eleventy/css/tailwind.css -o _site/assets/app.css --minify",
		"css:watch": "tailwindcss -i eleventy/css/tailwind.css -o _site/assets/app.css --watch",
		"js": "esbuild eleventy/assets/motion.js --bundle --splitting --format=esm --minify --target=es2022 --outdir=_site/assets"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-img": "^7.0.0",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/cli": "^4.3.3",
		"esbuild": "^0.28.1",
		"npm-run-all": "^4.1.5",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.3.0",
		"wrangler": "^4.118.0"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"gsap": "^3.15.0",
		"marked": "^18.0.5"
	},
	"overrides": {
		"sharp": "$sharp"
	},
	"allowScripts": {
		"sharp@0.35.3": true,
		"fsevents@2.3.3": true,
		"esbuild@0.28.1": true,
		"workerd@1.20260730.1": true,
		"@parcel/watcher": false
	}
}
