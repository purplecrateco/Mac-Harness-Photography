{
	"name": "mac-harness",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"assets": "node scripts/generate-assets.js",
		"build": "vite build",
		"build:11ty": "eleventy && npm run css:11ty && npm run js:11ty",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:contrast": "node scripts/check-hero-contrast.cjs",
		"check:masonry": "node scripts/check-masonry.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"css:11ty": "tailwindcss -i eleventy/css/tailwind.css -o _site/assets/app.css --minify",
		"css:11ty:watch": "tailwindcss -i eleventy/css/tailwind.css -o _site/assets/app.css --watch",
		"dev": "vite dev",
		"dev:11ty": "run-p serve:11ty css:11ty:watch \"js:11ty -- --watch\"",
		"js:11ty": "esbuild eleventy/assets/motion.js --bundle --splitting --format=esm --minify --target=es2022 --outdir=_site/assets",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"serve:11ty": "eleventy --serve"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-img": "^7.0.0",
		"@lucide/svelte": "^0.561.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^25.9.2",
		"esbuild": "^0.28.1",
		"npm-run-all": "^4.1.5",
		"sharp": "^0.35.3",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"wrangler": "^4.118.0"
	},
	"dependencies": {
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"gray-matter": "^4.0.3",
		"gsap": "^3.15.0",
		"marked": "^18.0.5",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2"
	},
	"overrides": {
		"sharp": "$sharp"
	},
	"allowScripts": {
		"sharp@0.35.3": true,
		"fsevents@2.3.3": true,
		"esbuild@0.28.1": true,
		"workerd@1.20260730.1": true,
		"@parcel/watcher": false
	}
}
