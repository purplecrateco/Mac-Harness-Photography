// Cloudflare Pages config.
//
// `pages_build_output_dir` is the Pages-only key — it's what makes this file apply to a
// Pages project rather than a Worker, and it replaces setting the output directory in
// the dashboard. Note the consequence: once this key is present, a deploy uses THIS file
// as production config, so it has to stay production-ready.
//
// The site is fully static: Eleventy writes plain HTML, there is no functions/ directory
// and no _worker.js, so Pages serves the output without running a Worker at all. That is
// why there are no compatibility_flags here — nodejs_compat was needed only for
// SvelteKit's server entry, which imported node:async_hooks. Add the flag back if a
// Pages Function is ever introduced.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mac-harness",
	"pages_build_output_dir": "_site",
	"compatibility_date": "2026-07-31"
}
