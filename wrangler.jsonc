// Cloudflare Pages config.
//
// `pages_build_output_dir` is the Pages-only key — it's what makes this file apply to a
// Pages project rather than a Worker, and it replaces setting the output directory in
// the dashboard. Note the consequence: once this key is present, a deploy uses THIS file
// as production config, so it has to stay production-ready.
//
// `nodejs_compat` is not optional. SvelteKit's server entry imports `node:async_hooks`
// (via @sveltejs/kit's internal event module), and without the flag the Worker bundle
// resolves it to nothing and can throw at runtime. `wrangler pages dev` warns about
// exactly this. Keeping it here rather than in the dashboard means it survives a project
// being recreated.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mac-harness",
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"compatibility_date": "2026-07-31",
	"compatibility_flags": ["nodejs_compat"]
}
