{#
  Port of Gallery.svelte — the homepage "Selected Work" peek.

  SPANS carries the asymmetric editorial grid placement plus the mobile collapse, one span
  per tile. Written out as literal class strings so Tailwind's text scanner sees them.
#}
{% import "macros.njk" as m %}
{%- set t = site.copy.gallery -%}
{%- set SIZES = '(max-width: 760px) 50vw, 33vw' -%}
{%- set SPANS = [
	'col-span-2 row-span-3 max-[760px]:col-span-1 max-[760px]:row-span-2',
	'col-span-2 row-span-2 max-[760px]:col-span-1',
	'col-span-2 row-span-3 max-[760px]:col-span-1 max-[760px]:row-span-2',
	'col-span-2 row-span-2 max-[760px]:col-span-1',
	'col-span-2 row-span-2 max-[760px]:col-span-1',
	'col-span-2 row-span-2 max-[760px]:col-span-1',
	'col-span-3 row-span-2 max-[760px]:col-span-2',
	'col-span-3 row-span-2 max-[760px]:col-span-2'
] -%}

<section id="gallery" class="t-gallery relative py-20 sm:py-28 lg:py-[140px]">
	<div class="mx-auto w-full max-w-[1320px] px-6 sm:px-10 lg:px-14">
		<div class="reveal mb-[60px] flex flex-wrap items-end justify-between gap-10">
			<div>
				{{ m.kicker(t.kicker) }}
				<h2 class="mt-3.5 font-serif text-[clamp(44px,6vw,84px)] font-normal leading-[0.96] tracking-[-0.01em] text-ink">
					{{ t.heading }} <em class="italic text-gold">{{ t.heading_accent }}</em>.
				</h2>
			</div>
			<div class="max-w-[280px] font-mono text-[12.5px] leading-[1.9] tracking-[0.04em] text-ink-dim max-[760px]:text-left sm:text-right">
				{% for line in t.note | lines %}{{ line }}<br />{% endfor %}
				<span class="text-ink-faint">{{ t.note_years }}</span>
				<br />
				<a
					href="/gallery/"
					class="mt-1 inline-block rounded-sm text-ink-dim underline decoration-ink-faint/50 underline-offset-4 transition-colors hover:text-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 focus-visible:ring-offset-1"
				>
					View all frames →
				</a>
			</div>
		</div>

		<div
			data-anim="gallery"
			class="reveal grid auto-rows-[128px] grid-cols-6 gap-[18px] max-[760px]:auto-rows-[120px] max-[760px]:grid-cols-2"
		>
			{% for p in homepage.peekPics %}
			<a
				href="/gallery/"
				aria-label="View the full gallery"
				class="group block {{ SPANS[loop.index0] }} rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 focus-visible:ring-offset-1"
			>
				<figure class="relative h-full w-full overflow-hidden rounded-2xl">
					{{ m.pic(p, SIZES, loop.index0 < 4, 'rounded-2xl transition-transform duration-700 ease-[cubic-bezier(0.2,0.7,0.3,1)] group-hover:scale-105') }}
				</figure>
			</a>
			{% endfor %}
		</div>
	</div>
</section>
