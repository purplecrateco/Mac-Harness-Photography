{#
  Port of src/app.html + src/routes/+layout.svelte.

  The arming script is load-bearing and must stay inline, blocking, and ahead of the
  body — see the long comment it carries. It is the reason the hero does not flash at
  its final position before GSAP takes over.
#}<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=Libre+Caslon+Display&family=Libre+Caslon+Text:ital@0;1&display=swap"
			rel="stylesheet"
		/>

		{#
			Port of Seo.svelte. `origin` comes from _data/meta.js rather than the request,
			since a static build has no request — the only behavioural difference, and it
			only matters for absolute URLs in OG tags.
		#}
		{%- set fullTitle = title if title == 'Mac Harness' else 'Mac Harness · ' ~ title -%}
		{%- set desc = description or meta.description -%}
		{%- set img = image or '/og.png' -%}
		{%- set imageUrl = img if img.startsWith('http') else meta.origin ~ img -%}
		{%- set canonical = meta.origin ~ page.url -%}
		<title>{{ fullTitle }}</title>
		<meta name="description" content="{{ desc }}" />
		<link rel="canonical" href="{{ canonical }}" />

		<meta property="og:type" content="{{ ogType or 'website' }}" />
		<meta property="og:site_name" content="Mac Harness" />
		<meta property="og:title" content="{{ fullTitle }}" />
		<meta property="og:description" content="{{ desc }}" />
		<meta property="og:url" content="{{ canonical }}" />
		<meta property="og:image" content="{{ imageUrl }}" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="{{ fullTitle }}" />
		<meta name="twitter:description" content="{{ desc }}" />
		<meta name="twitter:image" content="{{ imageUrl }}" />

		<link rel="icon" href="/favicon.png" sizes="512x512" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#070708" />
		<link rel="stylesheet" href="/assets/app.css" />

		<!--
			Arm the entrance animations before the first paint.

			The hero and page intros are animated in by GSAP, which is imported
			dynamically and therefore lands well after the HTML has already painted.
			Without this, elements show at their final position, get snapped to their
			start state when the timeline is built, and then glide in. Adding the class
			here, blocking and ahead of the body, means they are hidden from the very
			first frame instead. See the .motion-armed rules in app.css.

			The timeout is a failsafe: if the bundle never arrives or throws, content
			must not stay invisible. Motion code removes the class as soon as it owns
			the elements, and skips arming entirely under reduced-motion.
		-->
		<script>
			(function () {
				try {
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
					var root = document.documentElement;
					root.classList.add('motion-armed');
					setTimeout(function () {
						root.classList.remove('motion-armed');
					}, 4000);
				} catch (e) {
					/* no arming: content simply renders without an entrance */
				}
			})();
		</script>
	</head>
	<body>
		<div class="page">
			{% include "sections/navbar.njk" %}
			{{ content | safe }}
			{% include "sections/footer.njk" %}
		</div>
		<script type="module" src="/assets/motion.js"></script>
	</body>
</html>
